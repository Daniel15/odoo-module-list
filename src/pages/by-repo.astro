---
import Repository from '@components/Repository.astro';
import IndexLayout from '@layouts/IndexLayout.astro';
import {getCollection} from 'astro:content';

import {groupBy, sortByKey} from '../utils/map';

const modulesByRepo = sortByKey(
  groupBy(
    (await getCollection('modules')).map(module => module.data),
    module => module.repo,
  ),
);
---

<IndexLayout>
  Group by: <a href="/">None</a> | <strong>Repository</strong>

  {
    modulesByRepo
      .entries()
      .map(([repo, modules]) => <Repository modules={modules} repo={repo} />)
  }
</IndexLayout>
