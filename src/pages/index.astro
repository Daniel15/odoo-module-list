---
import ModuleTable from '@components/ModuleTable.astro';
import IndexLayout from '@layouts/IndexLayout.astro';
import {getCollection} from 'astro:content';

const modules = (await getCollection('repos')).flatMap(repo =>
  Object.entries(repo.data.modules).map(([internalName, module]) => ({
    ...module,
    internalName,
  })),
);
---

<IndexLayout>
  Group by: <strong>None</strong> | <a href="/by-repo">Repository</a>
  <ModuleTable modules={modules} />
</IndexLayout>
