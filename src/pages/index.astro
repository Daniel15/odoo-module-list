---
import ModuleTable from '@components/ModuleTable.astro';
import IndexLayout from '@layouts/IndexLayout.astro';
import {getCollection} from 'astro:content';

const modules = (await getCollection('modules')).map(module => module.data);
---

<IndexLayout>
  <p>
    <a download href="/modules-full.json">Download all data as JSON</a> (~8.6 MB)
  </p>
  <p>Group by: <strong>None</strong> | <a href="/by-repo">Repository</a></p>
  <ModuleTable modules={modules} />
</IndexLayout>
