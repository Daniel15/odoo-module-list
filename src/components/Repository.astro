---
import {ODOO_VERSIONS} from '../consts';
import type {ModuleInfo, RepoOutput} from '../schemas';
import ModuleVersionCheckbox from './ModuleVersionCheckbox.astro';

export interface Props {
  repo: RepoOutput;
}

const {repo} = Astro.props;

// Filter the modules to just the modules that are included in at least one of
// the versions we want to show.
const modules = Object.entries(repo.modules)
  .map(([internalName, module]) => ({...module, internalName}))
  .filter(module => ODOO_VERSIONS.some(version => module.versions[version] != null))
  .sort((a, b) => a.internalName.localeCompare(b.internalName));

function getDescription(module: ModuleInfo): string {
  for (let i = ODOO_VERSIONS.length - 1; i >= 0; i--) {
    const version = ODOO_VERSIONS[i];
    const versionData = module.versions[version];
    if (versionData && 'summary' in versionData) {
      return versionData.summary;
    }
  }
  return '';
}
---

{
  modules.length > 0 && (
    <>
      <h2>{repo.repo}</h2>

      <table class="table table-striped">
        <thead>
          <th scope="col">Name</th>
          {ODOO_VERSIONS.map(version => (
            <th class="version" scope="col">
              v{version}
            </th>
          ))}
        </thead>
        <tbody>
          {modules.map(module => (
            <tr>
              <td>
                <a href={repo.url} target="blank">
                  {module.internalName}
                </a>
                <br />
                <span class="small text-muted">{getDescription(module)}</span>
              </td>
              {ODOO_VERSIONS.map(version => (
                <td><ModuleVersionCheckbox module={module.versions[version]} /></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )
}

<style>
  th.version {
    width: 0;
  }
</style>
