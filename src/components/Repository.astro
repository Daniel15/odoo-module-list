---
import type {RepoOutput} from '../schemas';

import ModuleTable from './ModuleTable.astro';

export interface Props {
  repo: RepoOutput;
}

const {repo} = Astro.props;
const modules = Object.entries(repo.modules).map(([internalName, module]) => ({
  ...module,
  internalName,
}));
---

{
  modules.length > 0 && (
    <>
      <h2>{repo.repo}</h2>
      <ModuleTable modules={modules} />
    </>
  )
}
