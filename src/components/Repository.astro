---
import type {ModuleInfo} from '../schemas';

import ModuleTable from './ModuleTable.astro';

export interface Props {
  modules: readonly ModuleInfo[];
  repo: string;
}

const {modules, repo} = Astro.props;
---

{
  modules.length > 0 && (
    <>
      <h2>{repo}</h2>
      <ModuleTable modules={modules} />
    </>
  )
}
