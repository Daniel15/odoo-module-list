---
import type {ModuleInfo} from '../schemas';

import {ODOO_VERSIONS} from '../consts';
import ModuleRow from './ModuleRow.astro';

export interface Props {
  modules: readonly ModuleInfo[];
}

const {modules: modulesFromProps} = Astro.props;

// Filter the modules to just the modules that are included in at least one of
// the versions we want to show.
const modules = modulesFromProps
  .filter(module =>
    ODOO_VERSIONS.some(version => module.versions[version] != null),
  )
  .sort((a, b) => a.id.localeCompare(b.id));
---

<table class="table table-striped">
  <thead>
    <th scope="col">Name</th>
    {
      ODOO_VERSIONS.map(version => (
        <th class="version" scope="col">
          v{version}
        </th>
      ))
    }
  </thead>
  <tbody>
    {modules.map(module => <ModuleRow module={module} />)}
  </tbody>
</table>

<style>
  th.version {
    width: 0;
  }

  thead {
    position: sticky;
    top: 0;
  }
</style>
