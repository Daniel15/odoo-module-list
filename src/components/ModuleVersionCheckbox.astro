---
import ModulePullRequest from '@components/ModulePullRequest.astro';

import type {ModuleVersion} from '../schemas';

export interface Props {
  module: ModuleVersion | null;
}

const {module} = Astro.props;
---

{
  module == null ? (
    '❌'
  ) : 'migrationPR' in module ? (
    <ModulePullRequest pr={module.migrationPR} />
  ) : (
    '✅'
  )
}
