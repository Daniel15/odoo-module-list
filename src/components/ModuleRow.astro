---
import type {ModuleInfo} from '../schemas';

import {ODOO_VERSIONS} from '../consts';
import {getLatestManifest} from '../modules';
import ModuleVersionCheckbox from './ModuleVersionCheckbox.astro';

export interface Props {
  module: ModuleInfo;
}

const {module} = Astro.props;

const latestManifest = getLatestManifest(module);
---

{
  latestManifest == null ? null : (
    <tr>
      <td>
        {latestManifest?.repositoryURL == null ? (
          module.id
        ) : (
          <a href={latestManifest?.repositoryURL} target="blank">
            {module.id}
          </a>
        )}
        <br />
        <span class="small text-muted">{latestManifest?.summary}</span>
      </td>
      {ODOO_VERSIONS.map(version => (
        <td>
          <ModuleVersionCheckbox module={module.versions[version]} />
        </td>
      ))}
    </tr>
  )
}
