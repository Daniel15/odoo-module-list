---
import type {ImageMetadata} from 'astro';

import {SITE_TITLE} from '../consts';
import '../styles/styles.scss';

export interface Props {
  description: string;
  image?: ImageMetadata;
  title?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {description, image} = Astro.props;
const title =
  Astro.props.title == null
    ? SITE_TITLE
    : `${Astro.props.title} | ${SITE_TITLE}`;
---

<!doctype html>
<html data-bs-theme="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href={canonicalURL} rel="canonical" />
    <meta content={Astro.generator} name="generator" />

    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />

    <meta content="website" property="og:type" />
    <meta content={Astro.url} property="og:url" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    {
      image != null && (
        <meta content={new URL(image.src, Astro.url)} property="og:image" />
      )
    }

    <meta content="summary_large_image" property="twitter:card" />
    <meta content={Astro.url} property="twitter:url" />
    <meta content={title} property="twitter:title" />
    <meta content={description} property="twitter:description" />
    {
      image != null && (
        <meta
          content={new URL(image.src, Astro.url)}
          property="twitter:image"
        />
      )
    }
  </head>
  <body>
    <div class="container">
      <slot />
      <p class="text-center">
        <small>
          Made by <a href="https://d.sb/">Daniel Lo Nigro</a>.
          <a href="https://github.com/Daniel15/odoomodules">View source</a>.
        </small>
      </p>
    </div>
  </body>
</html>

<script>
  import {init} from '@plausible-analytics/tracker';
  init({
    captureOnLocalhost: window.location.search.includes('force_logging'),
    domain: 'odoomodules.com',
    endpoint: 'https://odoomodules.com/event',
    outboundLinks: true,
  });
</script>
